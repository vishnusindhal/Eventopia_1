# ============================================================
#  frontend/.env  — DEFAULT fallback (committed to Git)
# ============================================================
#  This file contains NON-SENSITIVE defaults that apply in
#  every environment UNLESS overridden by a more specific file.
#
#  Vite env file priority (highest → lowest):
#    .env.local          ← local overrides (git-ignored)
#    .env.[mode].local   ← e.g. .env.development.local
#    .env.[mode]         ← e.g. .env.production
#    .env                ← THIS FILE (lowest priority)
#
#  ✅ For local dev  → .env.local sets VITE_API_URL=http://localhost:5000/api
#  ✅ For production → Vercel environment variables override this value
#
#  DO NOT put secrets or production credentials here.
# ============================================================

# Fallback API URL (overridden by .env.local for local dev,
# and by Vercel env vars for production)
VITE_API_URL=http://localhost:5000/api