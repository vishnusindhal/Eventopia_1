# ---- Environment files ----
# .env          → Committed (contains safe defaults only — no secrets, no prod URLs)
# .env.local    → Git-ignored (local overrides, machine-specific)
# .env.*.local  → Git-ignored
# .env.production → Git-ignored (set prod vars in Vercel dashboard instead)

.env.local
.env.*.local
.env.production
