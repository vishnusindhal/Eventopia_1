# ============================================================
#  backend/.env.example
#  Copy this to ".env" and fill in real values.
#  This file IS committed to Git as documentation only.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/eventopia
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventopia?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# --- Email (Optional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Include both local dev URL and production Vercel URL.
# On Render (production), set this to your Vercel frontend URL only.
CLIENT_URL=http://localhost:5173,https://eventopia-1.vercel.app
