# ============================================================
#  Root .env.example for Eventopia (Docker and Local Run)
#  Copy this to a new file named ".env" at the root or within backend/
#  This file is committed to Git as documentation/reference.
# ============================================================

# --- Node Environment ---
NODE_ENV=development

# --- Backend Service Variables ---
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/eventopia
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# --- CORS and Origin Policy ---
# The Nginx gateway is the public entry point on port 80.
# For local development without Docker, add http://localhost:5173.
CLIENT_URL=http://localhost

# --- Email Notifications Service (Optional SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# --- Frontend Build Variables ---
# Injected at Docker build time. Routes through Nginx gateway.
# For local development without Docker, use http://localhost:5000/api
VITE_API_URL=http://localhost/api
