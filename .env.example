# ============================================================
#  Root .env.example for Eventopia (Docker and Local Run)
#  Copy this to a new file named ".env" at the root or within backend/
#  This file is committed to Git as documentation/reference.
# ============================================================

# --- Node Environment ---
NODE_ENV=development

# --- Backend Service Variables ---
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/eventopia
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# --- CORS and Origin Policy ---
# Comma-separated list of origins allowed to interact with the backend APIs.
# For Docker Compose, the frontend will default to running on port 3000.
CLIENT_URL=http://localhost:3000,http://localhost:5173

# --- Email Notifications Service (Optional SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# --- Frontend Build Variables ---
# Injected at Docker build time or local run time.
VITE_API_URL=http://localhost:5000/api
